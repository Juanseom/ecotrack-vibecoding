# EcoTrack AI — variables de entorno
# Copia este archivo como .env.local y completa los valores.
# .env.local está en .gitignore: nunca subas tu clave al repositorio.

# Clave de la API de Anthropic (Claude). Opcional.
# Si se deja vacía, la app funciona en "Modo demo" con un parser por reglas
# y la interfaz lo indica ("Modo demo · interpretación simulada").
ANTHROPIC_API_KEY=

# Modelo de Claude a usar. Opcional; si no se define se usa claude-opus-5.
ANTHROPIC_MODEL=claude-opus-5
